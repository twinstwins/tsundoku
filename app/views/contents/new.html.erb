<%= form_with model: @content, local: true do |f| %>
  <% if @content.errors.any? %>
    <div role="alert">
      <ul>
        <% @content.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="field">
    <%= f.label :name %>
    <%= f.text_field :name %>
  </div>

  <div class="field">
    <%= f.fields_for :photos do |i| %>
    <%= i.file_field :image, aria: { label: '投稿画像' } %>
  <% end %>
  </div>

  <div class="field">
    <%= f.label :description  %>
    <%= f.text_field :description %>
  </div>

  <%= f.submit "投稿", class: "btn btn-primary" %>
<% end %>

<% unless local_assigns[:react_follows] %>
  <div id="follow_counter"><%= render 'users/stats' %></div>
<% end %>
<% if user_signed_in? %>
  <% unless local_assigns[:react_follows] %>
    <div id="following_form"><%= render 'users/follow_form' %></div>
  <% end %>
  <% if current_user?(@user) %>
    <p><%= @user.email %></p>
    <p><%= link_to 'プロフィールを編集', edit_user_path(@user) %></p>
    <p><%= link_to 'パスワードを変更する', edit_user_registration_path %></p>
    <p><%= link_to 'サインアウト', destroy_user_session_path, method: :delete %></p>
  <% end %>
<% end %>

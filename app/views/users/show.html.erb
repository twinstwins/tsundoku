<% content_for :head do %><meta name="turbolinks-cache-control" content="no-cache"><% end %>
<main class="container py-4">
  <h1><%= @user.name %>のページ</h1>
  <p><%= @mycontents_count %>積んでいます</p>
  <% if @user.avatar? %>
    <%= image_tag @user.avatar.avatar_image.url %>
  <% else %>
    <p>No Image</p>
  <% end %>
  <section aria-label="プロフィールの操作" class="my-4">
    <%= render 'profile_actions' %>
  </section>
  <section aria-label="投稿">
    <h2>投稿</h2>
    <% if @contents.empty? %><p>投稿はまだありません。</p><% end %>
    <% @contents.each do |content| %>
      <article class="card mb-3">
        <div class="card-body">
          <p><%= link_to "#{content.name.presence || '無題の投稿'}さんの投稿", content_path(content) %></p>
          <p><%= content.description %></p>
          <% content.photos.each do |photo| %>
            <%= link_to content_path(content) do %>
              <%= image_tag photo.image.thumb.url if photo.image? %>
            <% end %>
          <% end %>
        </div>
      </article>
    <% end %>
  </section>
</main>

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "playwright.config.ts",
    "e2e/**/*.ts",
    "types/**/*.ts",
    "playwright.react.config.ts",
    "playwright.dev.config.ts",
    "e2e-react/**/*.ts",
    "e2e-dev/**/*.ts",
    "playwright.content.config.ts",
    "e2e-content/**/*.ts",
    "playwright.profile.config.ts",
    "e2e-profile/**/*.ts",
    "playwright.likes.config.ts",
    "e2e-likes/**/*.ts",
    "playwright.comments.config.ts",
    "e2e-comments/**/*.ts",
    "playwright.follows.config.ts",
    "e2e-follows/**/*.ts",
    "playwright.content-form.config.ts",
    "e2e-content-form/**/*.ts"
  ]
}

{
  "name": "Tsundoku",
  "private": true,
  "scripts": {
    "api:types": "npm --prefix tools/api-types run generate",
    "api:types:check": "npm --prefix tools/api-types run check",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}

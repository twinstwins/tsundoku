{
  "openapi": "3.0.3",
  "info": {
    "title": "Tsundoku API",
    "version": "1.0.0",
    "description": "同一オリジンのセッション認証。全応答はCache-Control: no-store。リストはID降順。メールとCSRFトークンは本人用の/meだけに含む。いいね更新は本人のセッションとCSRFトークンを検証する。"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/users": {
      "get": {
        "operationId": "listUsers",
        "summary": "公開ユーザー一覧",
        "security": [],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsersResponse"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PerPage"
          }
        ]
      }
    },
    "/api/v1/users/{id}": {
      "get": {
        "operationId": "getUser",
        "summary": "公開プロフィール",
        "security": [],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ]
      }
    },
    "/api/v1/users/{id}/following": {
      "get": {
        "operationId": "listFollowing",
        "summary": "フォロー先一覧",
        "security": [],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsersResponse"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PerPage"
          },
          {
            "$ref": "#/components/parameters/Id"
          }
        ]
      }
    },
    "/api/v1/users/{id}/followers": {
      "get": {
        "operationId": "listFollowers",
        "summary": "フォロワー一覧",
        "security": [],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsersResponse"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PerPage"
          },
          {
            "$ref": "#/components/parameters/Id"
          }
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "getMe",
        "summary": "ログイン本人の情報とCSRFトークン",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          }
        },
        "parameters": []
      }
    },
    "/api/v1/contents": {
      "get": {
        "operationId": "listContents",
        "summary": "ログインユーザー向け投稿一覧",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContentsResponse"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PerPage"
          },
          {
            "name": "feed",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "following"
              ],
              "default": "all"
            },
            "description": "followingは本人がフォローするユーザーの投稿。"
          }
        ]
      }
    },
    "/api/v1/contents/{id}": {
      "get": {
        "operationId": "getContent",
        "summary": "ログインユーザー向け投稿詳細",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContentResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ]
      }
    },
    "/api/v1/users/{id}/contents": {
      "get": {
        "operationId": "listUserContents",
        "summary": "公開プロフィールの投稿一覧",
        "description": "指定したユーザーの投稿だけをID降順で返す。メール・CSRFトークン・閲覧者別のいいね状態は含まない。",
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PerPage"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileContentsResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/v1/contents/{content_id}/like": {
      "put": {
        "operationId": "likeContent",
        "summary": "本人のいいねを登録済みにする",
        "description": "同じ要求の繰り返しでも最終状態は同じ。作成者はセッション、投稿はURLから決め、本文のuser_idやlike IDは使わない。X-CSRF-TokenにGET /api/v1/meのトークンを付ける。",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "content_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "要求した状態と現在の件数",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LikeStateResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "description": "CSRFトークンが不正。error.codeはinvalid_csrf_token。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "unlikeContent",
        "summary": "本人のいいねを解除済みにする",
        "description": "同じ要求の繰り返しでも最終状態は同じ。作成者はセッション、投稿はURLから決め、本文のuser_idやlike IDは使わない。X-CSRF-TokenにGET /api/v1/meのトークンを付ける。",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "content_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "要求した状態と現在の件数",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LikeStateResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "description": "CSRFトークンが不正。error.codeはinvalid_csrf_token。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UserSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "avatar_url"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "name": {
            "type": "string"
          },
          "avatar_url": {
            "type": "string",
            "nullable": true,
            "description": "同一オリジンの画像パス。未登録はnull。"
          }
        }
      },
      "UserDetail": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "avatar_url",
          "contents_count",
          "following_count",
          "followers_count"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "name": {
            "type": "string"
          },
          "avatar_url": {
            "type": "string",
            "nullable": true,
            "description": "同一オリジンの画像パス。未登録はnull。"
          },
          "contents_count": {
            "type": "integer",
            "minimum": 0
          },
          "following_count": {
            "type": "integer",
            "minimum": 0
          },
          "followers_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Me": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "avatar_url",
          "email",
          "csrf_token"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "name": {
            "type": "string"
          },
          "avatar_url": {
            "type": "string",
            "nullable": true,
            "description": "同一オリジンの画像パス。未登録はnull。"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "csrf_token": {
            "type": "string",
            "description": "更新時のX-CSRF-Token用。セッションCookieと併用する。"
          }
        }
      },
      "Photo": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "url",
          "thumbnail_url"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "url": {
            "type": "string",
            "nullable": true,
            "description": "同一オリジンの画像パス。未登録はnull。"
          },
          "thumbnail_url": {
            "type": "string",
            "nullable": true,
            "description": "同一オリジンの画像パス。未登録はnull。"
          }
        }
      },
      "Content": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "created_at",
          "user",
          "photos",
          "likes_count",
          "comments_count",
          "liked_by_current_user"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "$ref": "#/components/schemas/UserSummary"
          },
          "photos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Photo"
            }
          },
          "likes_count": {
            "type": "integer",
            "minimum": 0
          },
          "comments_count": {
            "type": "integer",
            "minimum": 0
          },
          "liked_by_current_user": {
            "type": "boolean"
          }
        }
      },
      "Pagination": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page",
          "per_page",
          "total_count",
          "total_pages"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "per_page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "total_count": {
            "type": "integer",
            "minimum": 0
          },
          "total_pages": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message",
              "fields"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "unauthenticated",
                  "not_found",
                  "invalid_request",
                  "validation_error",
                  "invalid_csrf_token",
                  "conflict"
                ]
              },
              "message": {
                "type": "string"
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "UsersResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserSummary"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/Pagination"
          }
        }
      },
      "ContentsResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Content"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/Pagination"
          }
        }
      },
      "UserResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/UserDetail"
          }
        }
      },
      "ContentResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Content"
          }
        }
      },
      "MeResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Me"
          }
        }
      },
      "ProfileContent": {
        "type": "object",
        "additionalProperties": false,
        "description": "既存の公開プロフィールと同じ投稿項目。本人情報や閲覧者別の状態は含まない。",
        "required": [
          "id",
          "name",
          "description",
          "created_at",
          "photos"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "photos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Photo"
            }
          }
        }
      },
      "ProfileContentsResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProfileContent"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/Pagination"
          }
        }
      },
      "LikeState": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "content_id",
          "likes_count",
          "liked_by_current_user"
        ],
        "properties": {
          "content_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "likes_count": {
            "type": "integer",
            "minimum": 0
          },
          "liked_by_current_user": {
            "type": "boolean"
          }
        }
      },
      "LikeStateResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/LikeState"
          }
        }
      }
    },
    "parameters": {
      "Page": {
        "name": "page",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000,
          "default": 1
        }
      },
      "PerPage": {
        "name": "per_page",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        }
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "_tsundoku_session",
        "description": "Deviseでログイン後にブラウザーが送信するRailsのCookie。"
      }
    },
    "responses": {
      "ValidationError": {
        "description": "422 入力不正。fieldsに項目別メッセージを返す。",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "404 対象なし。",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthenticated": {
        "description": "401 未認証。HTMLへのリダイレクトはしない。",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
